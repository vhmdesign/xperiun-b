# ══════════════════════════════════════════════════════════════════════════
# /ed/aichampion/certificado/ — emissão do certificado da Formação AI Champion.
#
# Página atrás de login (usuário e senha da turma, ver dependencias/acesso.js).
# Não deve aparecer em busca nenhuma nem ser varrida por crawler: além do
# <meta name="robots"> da página, o X-Robots-Tag abaixo cobre TODOS os arquivos
# da pasta (arte, badge, fonte, CSS e JS), e os crawlers conhecidos levam 403
# antes de ler qualquer coisa.
#
# Portado de /cp/treinamentos/.htaccess, com as diferenças desta pasta anotadas
# em cada bloco. O que é específico de página com login (o Basic Auth) veio de
# /cp/treinamentos/gerar/.htaccess e está no fim, comentado.
# ══════════════════════════════════════════════════════════════════════════

# Herda as regras do /ed/.htaccess pai.
RewriteEngine On
RewriteOptions inherit

# Sem listagem de diretório e sem content negotiation.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

DirectoryIndex index.html

# ──────────────────────────────────────────────────────────────────
# FORA DOS BUSCADORES
# ──────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noydir, noodp"
</IfModule>

# Crawler que se identifique como tal não passa. Inclui os buscadores
# (Googlebot, Bingbot e cia.), os de IA, os de SEO e os de scraping.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (Googlebot|Google-InspectionTool|Storebot-Google|APIs-Google|AdsBot|Mediapartners|Bingbot|BingPreview|msnbot|Slurp|DuckDuckBot|DuckAssistBot|Baiduspider|YandexBot|Sogou|Exabot|facebot|facebookexternalhit|ia_archiver|archive\.org_bot|Applebot|PetalBot|Qwantify|Neevabot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|anthropic-ai|Claude-Web|PerplexityBot|Perplexity-User|cohere-ai|CCBot|Bytespider|Amazonbot|Diffbot|Omgilibot|FacebookBot|meta-externalagent|Google-Extended|Applebot-Extended|Timpibot|Webzio|ImagesiftBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|MJ12Bot|DotBot|BLEXBot|DataForSeoBot|MegaIndex|serpstatbot|sistrix|linkfluence|Screaming\ Frog|SiteAuditBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|WebCopier|WebReaper|WebStripper|Offline\ Explorer|SiteSucker|Teleport|Wget|GrabNet|libwww|BlackWidow|CFNetwork) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (scrapy|python-requests|Go-http-client|httpx|curl/|aiohttp|node-fetch|axios|Java/|PostmanRuntime|Insomnia) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule .* - [F,L]
</IfModule>

# ──────────────────────────────────────────────────────────────────
# MÉTODOS E ARQUIVOS
# ──────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|PUT|PATCH|CONNECT)$
    RewriteRule .* - [F,L]
</IfModule>

# O LEIA-ME.md desta pasta cai aqui, junto com o resto do que nunca deve sair.
<FilesMatch "\.(md|markdown|log|bak|backup|tmp|swp|swo|orig|psd|fig|sketch|xd|ai|indd|zip|tar|gz|tgz|7z|rar|env|config|ini|conf|yml|yaml|sql|sqlite|db|sh|ps1|bat|exe|cjs|mjs|htpasswd|DS_Store)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(Thumbs\.db|\.htaccess|\.htpasswd|\.git.*|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Assets (arte do certificado, badge, fonte, css, js) só servem a partir das
# nossas páginas. Requisição sem referer nosso, ou aberta direto na barra de
# endereço, vira 404. É o que impede alguém de puxar a arte do certificado ou o
# badge em alta sem passar pela página.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?xperiun\.com/ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://app\.xperiun\.com/ [NC]
    RewriteRule \.(jpe?g|png|gif|webp|svg|avif|css|js|ttf|woff2?)$ - [R=404,NC,L]

    RewriteCond %{HTTP:Sec-Fetch-Dest} ^.+$
    RewriteCond %{HTTP:Sec-Fetch-Dest} !^style$ [NC]
    RewriteRule \.css$ - [R=404,NC,L]

    RewriteCond %{HTTP:Sec-Fetch-Dest} ^.+$
    RewriteCond %{HTTP:Sec-Fetch-Dest} !^script$ [NC]
    RewriteRule \.js$ - [R=404,NC,L]
</IfModule>

# ──────────────────────────────────────────────────────────────────
# SECURITY HEADERS
# ──────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Nada de iframe: nem no próprio site (não há motivo pra embutir isto).
    Header set X-Frame-Options "DENY"

    # same-origin, não no-referrer: para fora nada é enviado, mas as requisições
    # internas seguem mandando referer, que é o que o hotlink protection de
    # /ed/.htaccess exige pra servir root.css, as fontes e o logo. Trocar por
    # no-referrer deixa a página sem estilo.
    Header set Referrer-Policy "same-origin"

    Header set X-Content-Type-Options "nosniff"
    Header set Cross-Origin-Resource-Policy "same-origin"
    Header set Cross-Origin-Opener-Policy "same-origin"

    # Diferente do /cp/treinamentos/: lá o clipboard fica aberto por causa do
    # botão "Copiar link" do gerador. Aqui não existe esse botão, então fecha.
    Header set Permissions-Policy "clipboard-write=(), clipboard-read=(), camera=(), microphone=(), geolocation=(), interest-cohort=()"

    Header unset X-Powered-By
    Header unset Server

    # CSP em enforcement: esta página não tem <script> inline (o guard que seria
    # inline é o dependencias/guard.js), então script-src 'self' passa limpo.
    # blob: em img-src cobre o PDF montado no navegador. Tudo que a página
    # carrega é do próprio domínio: root.css, fonts.css e as Poppins são
    # self-hosted, não há CDN nem Google Fonts.
    #
    # form-action 'self', igual ao /cp/treinamentos/: os dois <form> da página
    # nunca submetem de verdade (o JS chama preventDefault), mas no repo do
    # Cloudflare existe um middleware que serve a PRÓPRIA tela de senha com um
    # <form method=POST> pro mesmo path. Manter os dois lados iguais evita que
    # ligar a trava de servidor lá esbarre numa CSP diferente aqui.
    #
    # Se um dia alguém colar GTM aqui, isto quebra — e é pra quebrar: página
    # atrás de login não leva tracking.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

    # Nada de cache em disco compartilhado pra página atrás de login.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, private"
    </FilesMatch>
</IfModule>

# ──────────────────────────────────────────────────────────────────
# BASIC AUTH (opcional — o mesmo bloco do /cp/treinamentos/gerar/.htaccess)
#
# O login da página é JavaScript: o acesso.js precisa chegar ao navegador pra
# desenhar a tela, e quem salvar esse arquivo pode testar senhas offline, sem
# limite e sem deixar rastro. Ligar o Basic Auth resolve na raiz: o Apache pede
# usuário e senha ANTES de entregar qualquer arquivo, então quem não acertar
# recebe 401 e não leva nem o HTML nem o acesso.js.
#
# O custo: o aluno digita senha duas vezes (a do navegador e a da página). Por
# isso está comentado, e não ligado por padrão.
#
# Jeito mais simples de ligar no cPanel/Hostinger: "Proteção de diretório"
# (Directory Privacy) apontando pra esta pasta — ele cria o .htpasswd com o
# hash certo e insere as diretivas sozinho.
#
# Na mão: gerar o .htpasswd (htpasswd -B -c .htpasswd incomparavel), subir pra
# cá e descomentar o bloco abaixo, com o caminho absoluto real da hospedagem.
# Se o caminho estiver errado, o Apache responde 500 na pasta inteira.
# ──────────────────────────────────────────────────────────────────
# AuthType Basic
# AuthName "Xperiun - certificado AI Champion"
# AuthUserFile /home/USUARIO/public_html/ed/aichampion/certificado/.htpasswd
# Require valid-user
